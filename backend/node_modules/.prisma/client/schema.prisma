// SENSO Limitless — production database schema
// Append-only financial ledger · materialized-path referral tree · soft deletes · audit fields

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum MatrixType {
  CLUB
  PILOT
}

enum MatrixPosition {
  ROOT
  LEFT
  RIGHT
  LEFT_CHILD
  RIGHT_CHILD
  SLOT_1
  SLOT_2
}

enum PlacementType {
  DIRECT
  SPILLOVER
}

enum MatrixEntryStatus {
  ACTIVE
  CYCLE_COMPLETE
  REBIRTH
  UPGRADED
}

enum IncomeType {
  DIRECT
  SPILLOVER
  CYCLE
  REBIRTH
  UPGRADE
  BONUS
  STAKING
  WITHDRAW
  DEPOSIT
  TOKEN_AIRDROP
  SPIN_REWARD
  WOM_REWARD
  PILOT_CYCLE
  PILOT_INCENTIVE
  SPONSOR_PAYMENT
  FIRST_LINE_BONUS
}

enum TokenRewardMode {
  FIXED_SLT
  PERCENTAGE
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum BlockchainTxType {
  DEPOSIT
  WITHDRAW
  REWARD
}

enum SpinRewardType {
  NO_TOKEN
  TOKEN_10
  TOKEN_200
  TOKEN_2000
  TOKEN_10000
  TOKEN_100000
}

enum WomSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StakeStatus {
  ACTIVE
  LOCKED
  COMPLETED
  CANCELLED
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
  FAILED
}

enum IdempotencyOperation {
  PACKAGE_PURCHASE
  CYCLE_COMPLETION
  INCOME_DISTRIBUTION
  REBIRTH_CREATION
  AUTO_UPGRADE
  WITHDRAWAL
  TOKEN_REWARD
  PLACEMENT
}

enum MatrixOperationType {
  PLACEMENT
  CYCLE_COMPLETION
  INCOME_DISTRIBUTION
  REBIRTH
  AUTO_UPGRADE
  SPILLOVER
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  walletAddress String     @unique @map("wallet_address")
  username      String?
  email         String?    @unique
  sponsorId     String?    @map("sponsor_id")
  referralCode  String     @unique @map("referral_code")
  /// Materialized path: /rootId/sponsorId/userId/ — enables O(1) upline lookups
  treePath      String     @default("/") @map("tree_path")
  treeDepth     Int        @default(0) @map("tree_depth")
  status        UserStatus @default(ACTIVE)
  isAdmin       Boolean    @default(false) @map("is_admin")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")
  createdBy     String?    @map("created_by")
  updatedBy     String?    @map("updated_by")

  sponsor         User?  @relation("SponsorTree", fields: [sponsorId], references: [id])
  directReferrals User[] @relation("SponsorTree")

  wallet           Wallet?
  sessions         Session[]
  clubMatrices     ClubMatrix[]
  pilotMatrices    PilotMatrix[]
  clubPackages     UserClubPackage[]
  pilotPackages    UserPilotPackage[]
  incomeLedger     IncomeLedger[]
  tokenRewards     TokenReward[]
  spinCoupons      SpinCoupon[]
  spinHistory      SpinHistory[]
  womSubmissions   WomSubmission[]
  stakes           Stake[]
  deposits         BlockchainTransaction[] @relation("UserDeposits")
  withdrawals      WithdrawalRequest[]
  placements       MatrixPlacement[]       @relation("PlacedUser")
  notifications    Notification[]
  packagePurchases PackagePurchase[]
  matrixOperations MatrixOperationLog[]

  @@index([sponsorId])
  @@index([referralCode])
  @@index([status])
  @@index([treePath])
  @@index([treeDepth])
  @@index([deletedAt])
  @@index([sponsorId, deletedAt])
  @@map("users")
}

model Wallet {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  availableBalance    Decimal  @default(0) @map("available_balance") @db.Decimal(36, 18)
  lockedBalance       Decimal  @default(0) @map("locked_balance") @db.Decimal(36, 18)
  withdrawableBalance Decimal  @default(0) @map("withdrawable_balance") @db.Decimal(36, 18)
  totalEarned         Decimal  @default(0) @map("total_earned") @db.Decimal(36, 18)
  totalWithdrawn      Decimal  @default(0) @map("total_withdrawn") @db.Decimal(36, 18)
  tokenBalance        Decimal  @default(0) @map("token_balance") @db.Decimal(36, 18)
  version             Int      @default(0)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── Package Purchases (idempotent) ──────────────────────────────────────────

model PackagePurchase {
  id             String     @id @default(cuid())
  userId         String     @map("user_id")
  packageLevel   Int        @map("package_level")
  matrixType     MatrixType @map("matrix_type")
  amount         Decimal    @db.Decimal(36, 18)
  txHash         String?    @map("tx_hash")
  isManual       Boolean    @default(false) @map("is_manual")
  idempotencyKey String     @unique @map("idempotency_key")
  createdAt      DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, packageLevel, matrixType])
  @@index([userId])
  @@index([txHash])
  @@map("package_purchases")
}

// ─── Club Matrix ─────────────────────────────────────────────────────────────

model UserClubPackage {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  packageLevel    Int       @map("package_level")
  purchasedAt     DateTime  @default(now()) @map("purchased_at")
  isManual        Boolean   @default(false) @map("is_manual")
  cyclesCompleted Int       @default(0) @map("cycles_completed")
  txHash          String?   @map("tx_hash")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, packageLevel])
  @@index([userId])
  @@index([packageLevel])
  @@index([deletedAt])
  @@map("user_club_packages")
}

model ClubMatrix {
  id             String            @id @default(cuid())
  ownerId        String            @map("owner_id")
  packageLevel   Int               @map("package_level")
  status         MatrixEntryStatus @default(ACTIVE)
  cycleNumber    Int               @default(1) @map("cycle_number")
  isRebirth      Boolean           @default(false) @map("is_rebirth")
  parentMatrixId String?           @map("parent_matrix_id")
  slotsFilled    Int               @default(0) @map("slots_filled")
  version        Int               @default(0)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  completedAt    DateTime?         @map("completed_at")
  deletedAt      DateTime?         @map("deleted_at")

  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentMatrix ClubMatrix?       @relation("RebirthChain", fields: [parentMatrixId], references: [id])
  rebirths     ClubMatrix[]      @relation("RebirthChain")
  placements   MatrixPlacement[]

  @@index([ownerId])
  @@index([packageLevel])
  @@index([status])
  @@index([ownerId, packageLevel, status])
  @@index([deletedAt])
  @@map("club_matrices")
}

model MatrixPlacement {
  id             String         @id @default(cuid())
  matrixId       String         @map("matrix_id")
  matrixType     MatrixType     @map("matrix_type")
  userId         String         @map("user_id")
  position       MatrixPosition
  placementType  PlacementType  @map("placement_type")
  spilloverFrom  String?        @map("spillover_from")
  sponsorId      String?        @map("sponsor_id")
  idempotencyKey String?        @unique @map("idempotency_key")
  createdAt      DateTime       @default(now()) @map("created_at")

  clubMatrix ClubMatrix? @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  user       User        @relation("PlacedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matrixId, position])
  @@unique([userId, matrixType, matrixId])
  @@index([userId])
  @@index([matrixType])
  @@index([sponsorId])
  @@map("matrix_placements")
}

// ─── Pilot Matrix ────────────────────────────────────────────────────────────

model UserPilotPackage {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  packageLevel    Int       @map("package_level")
  purchasedAt     DateTime  @default(now()) @map("purchased_at")
  isManual        Boolean   @default(false) @map("is_manual")
  cyclesCompleted Int       @default(0) @map("cycles_completed")
  txHash          String?   @map("tx_hash")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, packageLevel])
  @@index([userId])
  @@index([deletedAt])
  @@map("user_pilot_packages")
}

model PilotMatrix {
  id             String            @id @default(cuid())
  ownerId        String            @map("owner_id")
  packageLevel   Int               @map("package_level")
  status         MatrixEntryStatus @default(ACTIVE)
  cycleNumber    Int               @default(1) @map("cycle_number")
  isRebirth      Boolean           @default(false) @map("is_rebirth")
  parentMatrixId String?           @map("parent_matrix_id")
  slotsFilled    Int               @default(0) @map("slots_filled")
  version        Int               @default(0)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  completedAt    DateTime?         @map("completed_at")
  deletedAt      DateTime?         @map("deleted_at")

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentMatrix PilotMatrix?  @relation("PilotRebirthChain", fields: [parentMatrixId], references: [id])
  rebirths     PilotMatrix[] @relation("PilotRebirthChain")
  slots        PilotSlot[]

  @@index([ownerId])
  @@index([packageLevel])
  @@index([status])
  @@index([deletedAt])
  @@map("pilot_matrices")
}

model PilotSlot {
  id             String         @id @default(cuid())
  matrixId       String         @map("matrix_id")
  userId         String?        @map("user_id")
  position       MatrixPosition
  placementType  PlacementType? @map("placement_type")
  idempotencyKey String?        @unique @map("idempotency_key")
  filledAt       DateTime?      @map("filled_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  matrix PilotMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@unique([matrixId, position])
  @@index([userId])
  @@map("pilot_slots")
}

// ─── Immutable Financial Ledger (APPEND-ONLY — never update or delete) ───────

model IncomeLedger {
  id             String          @id @default(cuid())
  sequenceNum    BigInt          @default(autoincrement()) @map("sequence_num")
  userId         String          @map("user_id")
  type           IncomeType
  direction      LedgerDirection @default(CREDIT)
  amount         Decimal         @db.Decimal(36, 18)
  tokenAmount    Decimal?        @map("token_amount") @db.Decimal(36, 18)
  balanceAfter   Decimal?        @map("balance_after") @db.Decimal(36, 18)
  packageLevel   Int?            @map("package_level")
  matrixType     MatrixType?     @map("matrix_type")
  sourceUserId   String?         @map("source_user_id")
  matrixId       String?         @map("matrix_id")
  txHash         String?         @map("tx_hash")
  idempotencyKey String?         @unique @map("idempotency_key")
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([userId, type])
  @@index([sequenceNum])
  @@index([userId, sequenceNum])
  @@map("income_ledger")
}

model MatrixOperationLog {
  id             String              @id @default(cuid())
  userId         String              @map("user_id")
  operation      MatrixOperationType
  matrixType     MatrixType          @map("matrix_type")
  matrixId       String?             @map("matrix_id")
  packageLevel   Int?                @map("package_level")
  idempotencyKey String              @unique @map("idempotency_key")
  payload        Json
  createdAt      DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([operation])
  @@index([matrixId])
  @@map("matrix_operation_logs")
}

// ─── Blockchain ──────────────────────────────────────────────────────────────

model BlockchainTransaction {
  id             String            @id @default(cuid())
  userId         String            @map("user_id")
  type           BlockchainTxType
  amount         Decimal           @db.Decimal(36, 18)
  txHash         String            @unique @map("tx_hash")
  blockNumber    BigInt?           @map("block_number")
  status         TransactionStatus @default(PENDING)
  packageLevel   Int?              @map("package_level")
  matrixType     MatrixType?       @map("matrix_type")
  idempotencyKey String?           @unique @map("idempotency_key")
  createdAt      DateTime          @default(now()) @map("created_at")
  confirmedAt    DateTime?         @map("confirmed_at")

  user User @relation("UserDeposits", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("blockchain_transactions")
}

model WithdrawalRequest {
  id             String            @id @default(cuid())
  userId         String            @map("user_id")
  amount         Decimal           @db.Decimal(36, 18)
  walletAddress  String            @map("wallet_address")
  txHash         String?           @map("tx_hash")
  status         TransactionStatus @default(PENDING)
  idempotencyKey String?           @unique @map("idempotency_key")
  processedAt    DateTime?         @map("processed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("withdrawal_requests")
}

// ─── Token Rewards ───────────────────────────────────────────────────────────

model TokenReward {
  id             String      @id @default(cuid())
  userId         String      @map("user_id")
  amount         Decimal     @db.Decimal(36, 18)
  rewardType     String      @map("reward_type")
  packageLevel   Int?        @map("package_level")
  matrixType     MatrixType? @map("matrix_type")
  sourceUserId   String?     @map("source_user_id")
  txHash         String?     @map("tx_hash")
  idempotencyKey String?     @unique @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rewardType])
  @@map("token_rewards")
}

// ─── Spin & Win ────────────────────────────────────────────────────────────────

model SpinCoupon {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  source    String
  used      Boolean   @default(false)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, used])
  @@map("spin_coupons")
}

model SpinHistory {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  couponId       String         @map("coupon_id")
  rewardType     SpinRewardType @map("reward_type")
  tokenAmount    Decimal        @map("token_amount") @db.Decimal(36, 18)
  idempotencyKey String?        @unique @map("idempotency_key")
  createdAt      DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("spin_history")
}

// ─── Word of Mouth ───────────────────────────────────────────────────────────

model WomSubmission {
  id          String              @id @default(cuid())
  userId      String              @map("user_id")
  socialLink  String              @map("social_link")
  contentLink String?             @map("content_link")
  screenshot  String?
  status      WomSubmissionStatus @default(PENDING)
  reviewedBy  String?             @map("reviewed_by")
  reviewedAt  DateTime?           @map("reviewed_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewards WomReward[]

  @@index([userId])
  @@index([status])
  @@map("wom_submissions")
}

model WomReward {
  id             String   @id @default(cuid())
  submissionId   String   @map("submission_id")
  daiAmount      Decimal  @map("dai_amount") @db.Decimal(36, 18)
  tokenAmount    Decimal  @map("token_amount") @db.Decimal(36, 18)
  idempotencyKey String?  @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  submission WomSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("wom_rewards")
}

// ─── StackMint Staking ─────────────────────────────────────────────────────────

model Stake {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  amount       Decimal     @db.Decimal(36, 18)
  lockStart    DateTime    @map("lock_start")
  lockEnd      DateTime    @map("lock_end")
  rewardAmount Decimal     @default(0) @map("reward_amount") @db.Decimal(36, 18)
  status       StakeStatus @default(LOCKED)
  round        Int         @default(1)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  completedAt  DateTime?   @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("stakes")
}

// ─── System ──────────────────────────────────────────────────────────────────

model IdempotencyKey {
  id        String               @id @default(cuid())
  key       String               @unique
  operation IdempotencyOperation
  status    IdempotencyStatus    @default(PENDING)
  result    Json?
  createdAt DateTime             @default(now()) @map("created_at")
  expiresAt DateTime             @map("expires_at")

  @@index([expiresAt])
  @@index([operation, status])
  @@map("idempotency_keys")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  event     String
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

/// Append-only log of on-chain contract events (indexer only)
model ChainEvent {
  id            String   @id @default(cuid())
  txHash        String   @map("tx_hash")
  logIndex      Int      @map("log_index")
  blockNumber   BigInt?  @map("block_number")
  eventName     String   @map("event_name")
  walletAddress String?  @map("wallet_address")
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([txHash, logIndex])
  @@index([eventName])
  @@index([walletAddress])
  @@map("chain_events")
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

model LeaderboardEntry {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  totalEarned Decimal  @map("total_earned") @db.Decimal(36, 18)
  directCount Int      @default(0) @map("direct_count")
  teamSize    Int      @default(0) @map("team_size")
  rank        Int      @default(0)
  computedAt  DateTime @map("computed_at")

  @@index([rank])
  @@index([totalEarned(sort: Desc)])
  @@map("leaderboard_entries")
}

// ─── Blockchain analytics (indexer-only — on-chain source of truth) ───────────

model IndexerState {
  id            String   @id @default("main")
  chainId       Int      @map("chain_id")
  lastBlock     BigInt   @default(0) @map("last_block")
  lastBlockHash String?  @map("last_block_hash")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("indexer_state")
}

model IndexedUser {
  walletAddress   String   @id @map("wallet_address")
  sponsorAddress  String?  @map("sponsor_address")
  registeredAt    DateTime @map("registered_at")
  registeredBlock BigInt   @map("registered_block")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("idx_users")
}

model IndexedReferral {
  id              String   @id @default(cuid())
  sponsorAddress  String   @map("sponsor_address")
  referralAddress String   @map("referral_address")
  blockNumber     BigInt   @map("block_number")
  txHash          String   @map("tx_hash")
  logIndex        Int      @map("log_index")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([txHash, logIndex])
  @@index([sponsorAddress])
  @@map("idx_referrals")
}

model IndexedClubMatrix {
  id           String   @id @default(cuid())
  matrixId     BigInt   @map("matrix_id")
  ownerAddress String   @map("owner_address")
  level        Int
  eventName    String   @map("event_name")
  blockNumber  BigInt   @map("block_number")
  txHash       String   @map("tx_hash")
  logIndex     Int      @map("log_index")
  payload      Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([txHash, logIndex])
  @@index([ownerAddress])
  @@index([matrixId])
  @@map("idx_club_matrices")
}

model IndexedPilotMatrix {
  id           String   @id @default(cuid())
  matrixId     BigInt   @map("matrix_id")
  ownerAddress String   @map("owner_address")
  level        Int
  eventName    String   @map("event_name")
  blockNumber  BigInt   @map("block_number")
  txHash       String   @map("tx_hash")
  logIndex     Int      @map("log_index")
  payload      Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([txHash, logIndex])
  @@index([ownerAddress])
  @@index([matrixId])
  @@map("idx_pilot_matrices")
}

model IndexedTransaction {
  id            String   @id @default(cuid())
  walletAddress String   @map("wallet_address")
  eventName     String   @map("event_name")
  blockNumber   BigInt   @map("block_number")
  txHash        String   @map("tx_hash")
  logIndex      Int      @map("log_index")
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([txHash, logIndex])
  @@index([walletAddress])
  @@map("idx_transactions")
}

model IndexedIncome {
  id               String   @id @default(cuid())
  recipientAddress String   @map("recipient_address")
  payerAddress     String?  @map("payer_address")
  incomeType       Int      @map("income_type")
  matrixType       Int      @map("matrix_type")
  level            Int
  amount           Decimal  @db.Decimal(36, 18)
  blockNumber      BigInt   @map("block_number")
  txHash           String   @map("tx_hash")
  logIndex         Int      @map("log_index")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([txHash, logIndex])
  @@index([recipientAddress])
  @@map("idx_incomes")
}

model IndexedTokenReward {
  id               String   @id @default(cuid())
  recipientAddress String   @map("recipient_address")
  sourceAddress    String?  @map("source_address")
  rewardType       Int      @map("reward_type")
  matrixType       Int      @map("matrix_type")
  level            Int
  sltAmount        Decimal  @map("slt_amount") @db.Decimal(36, 18)
  blockNumber      BigInt   @map("block_number")
  txHash           String   @map("tx_hash")
  logIndex         Int      @map("log_index")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([txHash, logIndex])
  @@index([recipientAddress])
  @@map("idx_token_rewards")
}

model IndexedWithdrawal {
